# Copy this file to backend/.env and fill in the values marked "REQUIRED".

NODE_ENV=development
PORT=5000

# REQUIRED - MySQL connection string. Matches docker-compose defaults.
DATABASE_URL=mysql://root:password@localhost:3306/reachinbox

REDIS_HOST=localhost
REDIS_PORT=6379

ELASTICSEARCH_URL=http://localhost:9200

# REQUIRED - Google Cloud Console OAuth 2.0 credentials.
# See README section "Google OAuth Setup".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Secrets used to sign the auth JWT / session. Change these for anything
# beyond local development.
SESSION_SECRET=dev-session-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me

# REQUIRED - Ethereal SMTP credentials (create a free inbox at
# https://ethereal.email). Used as the default sender's credentials.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Worker / rate-limiting tuning - see README sections 24-26.
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# REQUIRED for Slack notifications - see README "Slack OAuth Setup".
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Optional - protects the Bull Board dashboard at /admin/queues.
# Defaults to admin/admin if unset (development only).
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
