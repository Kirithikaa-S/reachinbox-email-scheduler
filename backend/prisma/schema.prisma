// ReachInbox Email Scheduler - Prisma schema (MySQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  name      String
  email     String   @unique
  avatar    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders         Sender[]
  campaigns       Campaign[]
  slackConnection SlackConnection?

  @@index([email])
}

model Sender {
  id                String   @id @default(uuid())
  userId            String
  email             String
  name              String
  etherealUser      String
  etherealPassword  String
  createdAt         DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledEmail ScheduledEmail[]

  @@index([userId])
}

enum CampaignStatus {
  scheduled
  processing
  completed
  cancelled
}

model Campaign {
  id          String         @id @default(uuid())
  userId      String
  subject     String
  body        String         @db.Text
  startTime   DateTime
  delayMs     Int            @default(2000)
  hourlyLimit Int            @default(200)
  status      CampaignStatus @default(scheduled)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails ScheduledEmail[]

  @@index([userId])
}

enum EmailStatus {
  scheduled
  processing
  sent
  failed
  cancelled
}

model ScheduledEmail {
  id          String      @id @default(uuid())
  campaignId  String
  senderId    String
  recipient   String
  subject     String
  body        String      @db.Text
  sequence    Int         @default(0)
  scheduledAt DateTime
  status      EmailStatus @default(scheduled)
  bullJobId   String?     @unique
  attempts    Int         @default(0)
  sentAt      DateTime?
  failedAt    DateTime?
  messageId   String?
  previewUrl  String?     @db.Text
  error       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([senderId])
  @@index([status])
  @@index([recipient])
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  accessToken String   @db.Text
  teamId      String
  teamName    String?
  channelId   String?
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
